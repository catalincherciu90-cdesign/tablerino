{
  "name": "tablerino-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Tablerino — restaurant ordering platform on Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute tablerino --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute tablerino --remote --file=./schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
